const sheet = context.workbook.worksheets.getItem("Model");

// Column widths
sheet.getRange("A:A").format.columnWidth = 200;
sheet.getRange("B:G").format.columnWidth = 100;

// Section header backgrounds
const sectionRows = ["A4:G4", "A14:G14", "A23:G23"];
for (const r of sectionRows) {
  const range = sheet.getRange(r);
  range.format.fill.color = "#D9E1F2";
}

// Subtotal rows - bottom border (Gross Profit, EBT, Net Income)
const subtotalRows = ["B7:G7", "B10:G10", "B12:G12", "B17:G17", "B19:G19", "B21:G21", "B27:G27", "B31:G31"];
for (const r of subtotalRows) {
  const range = sheet.getRange(r);
  range.format.borders.getItem("EdgeTop").style = "Continuous";
  range.format.borders.getItem("EdgeTop").weight = "Thin";
}

// Double bottom border for key totals (Net Income, Net Cash Change, Total Assets, Total L&E)
const doubleBottomRows = ["B12:G12", "B21:G21", "B27:G27", "B31:G31"];
for (const r of doubleBottomRows) {
  const range = sheet.getRange(r);
  range.format.borders.getItem("EdgeBottom").style = "Double";
  range.format.borders.getItem("EdgeBottom").weight = "Thick";
}

// Balance check row formatting
const checkRange = sheet.getRange("B33:G33");
checkRange.format.borders.getItem("EdgeBottom").style = "Double";
checkRange.format.borders.getItem("EdgeBottom").weight = "Thick";

// Period header bottom border
const headerRange = sheet.getRange("A2:G2");
headerRange.format.borders.getItem("EdgeBottom").style = "Continuous";
headerRange.format.borders.getItem("EdgeBottom").weight = "Medium";

// Freeze pane: freeze column A and rows 1-2
sheet.freezePanes.freezeRows(2);
sheet.freezePanes.freezeColumns(1);

// Balance check conditional - green if 0, red if not
const balCheckCf = sheet.getRange("B33:G33").conditionalFormats;
const cfZero = balCheckCf.add(Excel.ConditionalFormatType.cellValue);
cfZero.cellValue.format.font.color = "#008000";
cfZero.cellValue.rule = { formula1: "0", operator: Excel.ConditionalCellValueOperator.equalTo };

const cfNotZero = balCheckCf.add(Excel.ConditionalFormatType.cellValue);
cfNotZero.cellValue.format.font.color = "#FF0000";
cfNotZero.cellValue.format.fill.color = "#FFC7CE";
cfNotZero.cellValue.rule = { formula1: "0", operator: Excel.ConditionalCellValueOperator.notEqualTo };

await context.sync();
return { success: true };